# File: client/.env.example
# Copy this file to client/.env. Only variables starting with VITE_ are sent to the browser,
# so never put server secrets (JWT_SECRET and so on) in client configuration.

# Address of the Express API. It must end with /api and must not end with a slash.
# Local default, matching PORT=4000 in server/.env:
VITE_API_URL=http://localhost:4000/api

# In production (Vercel), set this to your Render URL followed by /api, for example:
# VITE_API_URL=https://your-service.onrender.com/api
