# Copy this file to server/.env and fill it in. Never commit server/.env.

NODE_ENV=development
PORT=4000

# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact origin of the React app, with no path (Vite dev default shown).
CLIENT_ORIGIN=http://localhost:5173

# SQLite file. Relative paths are resolved from the server folder.
DB_PATH=./data/app.db

# Optional. Set to true to add demo accounts and a sample quiz on startup.
SEED_DEMO=false
